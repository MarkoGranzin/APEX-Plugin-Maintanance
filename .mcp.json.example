{
  "//": "Copy to .mcp.json (git-ignored) and fill in your own values. NEVER commit the real .mcp.json — it holds host names, workspace IDs and credentials. Secrets belong in environment variables, referenced here as ${VAR}.",
  "mcpServers": {
    "apex-deploy": {
      "command": "node",
      "args": ["./mcp-apex-deploy/server.js"],
      "env": {
        "APEX_SQLCL": "sql",
        "APEX_CONN": "",
        "APEX_WORKSPACE": "<YOUR_WORKSPACE>",
        "APEX_APP_ID": "<YOUR_APP_ID>",
        "APEX_BASE_URL": "https://<your-instance>.adb.<region>.oraclecloudapps.com/ords",
        "APEX_LOGIN_USER": "<YOUR_APEX_USER>",
        "APEX_LOGIN_PASS": "${APEX_LOGIN_PASS}",
        "APEX_WORKSPACE_ID": "<YOUR_WORKSPACE_ID>",
        "APEX_OWNER": "<YOUR_SCHEMA_OWNER>",
        "APEX_RELEASE": "24.2"
      }
    }
  }
}
